{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "SoundCloud",
    "version": "0.1.0",
    "identifier": "io.rvelabs.soundcloud.android",
    "build": { "frontendDist": "frontend" },
    "app": {
        "windows": [{ "label": "main", "title": "SoundCloud", "url": "index.html" }],
        "security": {
            "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
            "capabilities": ["main"]
        }
    },
    "bundle": {
        "active": true,
        "android": { "minSdkVersion": 26 },
        "icon": ["../assets/icons/soundcloud.png"]
    }
}
