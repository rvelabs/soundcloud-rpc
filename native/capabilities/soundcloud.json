{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "soundcloud",
    "description": "Fixed SoundCloud operations in the main top-level WebView only",
    "remote": {
        "urls": [
            "https://soundcloud.com/*"
        ]
    },
    "permissions": [
        "allow-catalog-request",
        "allow-profile-load",
        "allow-profile-save",
        "allow-profile-flush",
        "allow-wave-active",
        "allow-monitor-ready",
        "allow-native-diagnostics",
        "allow-source-request",
        "allow-source-cancel",
        "allow-spotify-open",
        "allow-spotify-state",
        "allow-spotify-show",
        "allow-spotify-close",
        "allow-open-settings",
        "allow-smoke-result",
        "allow-presence-update",
        "allow-listening-update",
        "allow-listening-status",
        "allow-extensions-apply",
        "allow-updates-status",
        "allow-account-result",
        "allow-client-options",
        "allow-extensions-theme",
        "allow-taskbar-update"
    ],
    "webviews": [
        "main"
    ]
}
