{
    "name": "soundcloud-rpc",
    "version": "0.30.5",
    "workerProtocolRevision": 4,
    "description": "SoundCloud desktop client with personalized radio, playlist import, Discord Rich Presence and Last.fm",
    "author": {
        "name": "Richard Habitzreuter",
        "email": "richardhabitzreuter@icloud.com"
    },
    "license": "MIT",
    "scripts": {
        "lint": "eslint -c eslint.config.mjs --ext .ts,.js ./src",
        "test": "vitest run",
        "test:worker": "node scripts/check-worker-runtime.cjs",
        "test:import": "tsc && node scripts/check-playlist-worker.cjs --electron",
        "test:watch": "vitest",
        "test:placement": "electron scripts/check-wave-placement.cjs",
        "copy-header": "node scripts/copy-assets.cjs",
        "dev": "tsc && npm run copy-header && electron ./tsc/main.js --dev",
        "build": "tsc && npm run copy-header && electron-builder --dir",
        "build-win": "tsc && npm run copy-header && electron-builder -w nsis --publish never && node scripts/prepare-update-feed.cjs build",
        "build-win-ptb": "tsc && npm run copy-header && electron-builder -w portable",
        "build-mac": "tsc && npm run copy-header && electron-builder -m dmg",
        "build-linux-deb": "tsc && npm run copy-header && electron-builder -l deb",
        "build-linux-appimage": "tsc && npm run copy-header && electron-builder -l appimage",
        "compile": "tsc && node scripts/copy-assets.cjs",
        "test:runtime": "npm run compile && node scripts/check-runtime.cjs",
        "test:assets": "node scripts/check-assets.cjs"
    },
    "main": "./tsc/main.js",
    "repository": "https://github.com/rvelabs/soundcloud-rpc",
    "build": {
        "appId": "dev.codex.soundcloud-wave",
        "productName": "SoundCloud",
        "asar": true,
        "publish": {
            "provider": "github",
            "owner": "rvelabs",
            "repo": "soundcloud-rpc",
            "releaseType": "release"
        },
        "extraResources": [
            {
                "from": "assets/icons",
                "to": "assets/icons"
            },
            {
                "from": "cloudflare/soundcloud-relay",
                "to": "soundcloud-relay",
                "filter": [
                    "**/*",
                    "!node_modules/**",
                    "!.wrangler/**"
                ]
            },
            {
                "from": "README.md",
                "to": "soundcloud-relay/README.md"
            }
        ],
        "files": [
            "tsc/**/*",
            "!tsc/**/*.test.js",
            "!tsc/**/*.test.js.map",
            "!node_modules/electron/**/*"
        ],
        "directories": {
            "buildResources": "build-resources",
            "output": "build"
        },
        "electronDownload": {
            "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
        },
        "afterSign": "scripts/sign-vmp.js",
        "mac": {
            "target": "dmg",
            "icon": "assets/icons/soundcloud-mac.icns",
            "artifactName": "soundcloud-${version}-mac.${ext}",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build-resources/entitlements.mac.plist",
            "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist"
        },
        "win": {
            "target": "nsis",
            "icon": "assets/icons/soundcloud-win.ico",
            "artifactName": "soundcloud-${version}-installer-win.${ext}",
            "executableName": "SoundCloud",
            "signAndEditExecutable": true
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "icon": "assets/icons/soundcloud.png",
            "category": "AudioVideo",
            "executableName": "soundcloud-rpc",
            "synopsis": "SoundCloud client with Discord Rich Presence",
            "artifactName": "soundcloud-${version}-linux.${ext}",
            "desktop": {
                "entry": {
                    "Name": "SoundCloud",
                    "Comment": "SoundCloud client with Discord Rich Presence",
                    "Categories": "AudioVideo;Audio;Music;",
                    "StartupWMClass": "soundcloud-rpc"
                }
            }
        },
        "nsis": {
            "shortcutName": "SoundCloud",
            "uninstallDisplayName": "SoundCloud",
            "installerIcon": "assets/icons/soundcloud-win.ico",
            "uninstallerIcon": "assets/icons/soundcloud-win.ico"
        }
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.37.0",
        "@types/node": "^24.2.1",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "electron": "github:castlabs/electron-releases#1d4c9294730fd5fa95ec62081c549cd13c74bdbd",
        "electron-builder": "^26.7.0",
        "esbuild": "0.27.7",
        "eslint": "^9.33.0",
        "globals": "^14.0.0",
        "miniflare": "4.20260730.0",
        "prettier": "3.6.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.46.0",
        "vitest": "^3.1.3"
    },
    "dependencies": {
        "@ghostery/adblocker-electron": "^2.20.1",
        "@xhayper/discord-rpc": "^1.5.1",
        "cross-fetch": "^4.0.0",
        "discord-api-types": "^0.38.18",
        "electron-prompt": "^1.7.0",
        "electron-store": "^8.1.0",
        "electron-updater": "^6.8.11",
        "electron-window-state": "^5.0.3",
        "ws": "^8.22.0"
    }
}
